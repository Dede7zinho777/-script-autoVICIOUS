-- Update button visual
local function updateButtonVisual()
    hopButton.Visible = true
    if scanState.autoHopActive then
        hopButton.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        hopButton.Text = "🟢 AUTO HOP ATIVO"
        hopButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    else
        hopButton.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        hopButton.Text = "🔴 AUTO HOP DESATIVADO"
        hopButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

-- Auto Hop Toggle Logic
hopButton.MouseButton1Click:Connect(function()
    if scanState.viciousFound then
        print("⚠️ Vicious found - cannot toggle")
        return
    end
    
    scanState.autoHopActive = not scanState.autoHopActive
    print("🔘 Button clicked - autoHop: " .. tostring(scanState.autoHopActive))
    
    updateButtonVisual()
    
    if scanState.autoHopActive then
        print("✅ AUTO HOP: ON - Starting hop loop")
        notify("AUTO VICIOUS - CHX", "✅ Auto Hop ON")
    else
        print("❌ AUTO HOP: OFF - Staying on server")
        notify("AUTO VICIOUS - CHX", "❌ Auto Hop OFF")
    end
end)

local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 3
        })
    end)
end

local function updateStatus(text)
    pcall(function()
        statusLabel.Text = text
    end)
end

local function getHRP()
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function waitForCharacter()
    if not player.Character then player.CharacterAdded:Wait() end
    local char = player.Character
    char:WaitForChild("HumanoidRootPart", 10)
    char:WaitForChild("Humanoid", 10)
    task.wait(0.3)
end

task.spawn(function()
    task.wait(0.5)
    local currentId = game.JobId
    if currentId and currentId ~= "" then
        blacklistedServers[currentId] = tick()
    end
end)

local function isBlacklisted(id)
    if not blacklistedServers[id] then return false end
    if tick() - blacklistedServers[id] > BLACKLIST_DURATION then
        blacklistedServers[id] = nil
        return false
    end
    return true
end

local function serverHop()
    print("🔀 Hopping...")
    updateStatus("🔀 Hopping...\n\n")
    
    local placeId = game.PlaceId
    local currentId = game.JobId
    
    if currentId and currentId ~= "" then
        blacklistedServers[currentId] = tick()
    end

    local hopSuccess = false
    local attempts = 0
    
    while scanState.autoHopActive and not hopSuccess and attempts < 5 do
        attempts = attempts + 1
        
        local ok, err = pcall(function()
            local url = "https://games.roblox.com/v1/games/"..placeId.."/servers/Public?sortOrder=Asc&limit=100"
            local data = Http:JSONDecode(game:HttpGet(url))

            local servers = {}
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if not isBlacklisted(s.id)
                        and not s.accessCode
                        and s.playing and s.maxPlayers
                        and s.playing < math.floor(s.maxPlayers * 0.8) then
                        table.insert(servers, s)
                    end
                end
            end

            if #servers == 0 then 
                print("❌ No servers")
                task.wait(3)
                return false
            end

            local picked = servers[math.random(1, #servers)]
            if picked and scanState.autoHopActive then
                print("🎯 Server: " .. picked.playing .. "/" .. picked.maxPlayers)
                blacklistedServers[picked.id] = tick()
                TeleportService:TeleportToPlaceInstance(placeId, picked.id, player)
                hopSuccess = true
                return true
            end
            return false
        end)
        
        if not ok then
            print("⚠️ Hop attempt " .. attempts)
            task.wait(2)
        elseif hopSuccess then
            task.wait(5)
            return true
        end
    end
    
    if not hopSuccess then
        print("❌ Hop failed")
        task.wait(5)
        return false
    end
end

local function findVicious()
    local ok, result = pcall(function()
        local monsters = workspace:FindFirstChild("Monsters")
        if not monsters then return nil end
        for _, v in ipairs(monsters:GetChildren()) do
            if v.Name:find("Vicious Bee") then
                local hum = v:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then return v end
            end
        end
        return nil
    end)
    return result
end

local function getPositionText(pos)
    return string.format("X: %.0f | Y: %.0f | Z: %.0f", pos.X, pos.Y, pos.Z)
end

local function main()
    waitForCharacter()
    
    updateStatus("⏳ Starting...\n\n")
    updateButtonVisual()
    task.wait(3)
    
    while true do
        task.wait(0.3)
        
        pcall(function()
            local vic = findVicious()
            
            if vic then
                -- Vicious found
                local vicRoot = vic:FindFirstChild("HumanoidRootPart") or vic.PrimaryPart
                if vicRoot then
                    local pos = getPositionText(vicRoot.Position)
                    print("✅ VICIOUS: " .. pos)
                    
                    if not scanState.viciousFound then
                        scanState.viciousFound = true
                        scanState.autoHopActive = false
                        updateButtonVisual()
                        
                        updateStatus("🟢 VICIOUS FOUND!\n\nPos:\n" .. pos .. "\n\nClick HOP NOW")
                        notify("AUTO VICIOUS - CHX", "🐝 ENCONTRADA!")
                    end
                    
                    -- Auto hop stays disabled until the user turns it on again.
                    updateStatus("🛑 AUTO HOP DESATIVADO\nVicious encontrada\n\n")
                    task.wait(1)
                end
            else
                -- No vicious found
                if scanState.autoHopActive and not scanState.viciousFound then
                    -- Auto hop is ON - keep hopping
                    updateStatus("🔀 Hopping servers...\n\n")
                    serverHop()
                else
                    -- Auto hop is OFF - stay and scan
                    updateStatus("🔍 Scanning...\n(Auto Hop: OFF)\n\n")
                    task.wait(1)
                end
            end
        end)
    end
end

task.spawn(main)
print("🐝 AUTO VICIOUS - CHX LOADED!")
